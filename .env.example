# Copy to .env for local development. Placeholders only — never commit real values.
# On Netlify, set these under Project configuration → Environment variables.

# ── Database (Netlify Database / Postgres) ────────────────────────────────────
# Set automatically by Netlify on every deploy and by `netlify dev` (local PGlite emulation).
# Only set it yourself to point a script (e.g. `pnpm db:seed-demo`) at a specific branch.
# NETLIFY_DB_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Slack order notifications (server-side only) ──────────────────────────────
# Either an incoming webhook…
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/XXXX/XXXX
# …or a bot token plus the channel to post in (the bot must be invited to the channel).
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0123456789

# ── Demo seed safety ──────────────────────────────────────────────────────────
# Set to 1 only if you really want `pnpm db:seed-demo` to write demo rows to production.
ALLOW_PRODUCTION_SEED=0

# Netlify Blobs (product images) and Netlify Identity (admin sign-in) need no variables:
# both are configured automatically by the Netlify runtime and `netlify dev`.
